<resources>
    <style name="Theme.SumanMovies" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.SumanMovies.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sumanmovies_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sumanmovies_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SumanMovies</item>
    </style>

    <style name="Theme.SumanMovies.Player" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
