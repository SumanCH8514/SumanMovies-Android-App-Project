{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-moviebox-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.moviebox.sumanonline.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
